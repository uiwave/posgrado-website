---
import type { TipoProgramaResponse } from "@/types/api";

interface Props {
  tipo: TipoProgramaResponse;
}

const { tipo } = Astro.props;
---

<a
  href={tipo.slug}
  class="relative group grow transition-all w-56 h-100 duration-500 hover:w-full"
>
  <img
    class="h-full w-full object-cover object-top"
    src={tipo.imagenCard}
    alt="image"
  />
  <div
    class="absolute inset-0 flex flex-col justify-end p-10 text-white bg-black/50 opacity-0 group-hover:opacity-100 transition-all duration-300"
  >
    <h1 class="text-3xl">{tipo.nombre}</h1>
  </div>
</a>
