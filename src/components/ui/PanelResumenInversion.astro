---
import type { Inversion } from "@/types/api";
import { formatMoney } from "@/lib/money";

interface Props {
  inversion: Inversion;
}

const { inversion } = Astro.props;
---

<section class="bg-white p-8 shadow-md border border-gray-100">
  <h2
    class="font-display text-primary text-[clamp(1.8rem,4vw,2.5rem)] leading-none tracking-wide uppercase mb-6"
  >
    Resumen de Inversión
  </h2>

  <div class="space-y-4 mb-6 text-sm">
    <div
      class="border-neutral-dark/10 flex justify-between items-center border-b py-3"
    >
      <span class="text-neutral-dark/70">Matrícula por periodo:</span>
      <span class="text-neutral-dark font-semibold">
        {formatMoney(inversion?.costoMatricula)}
      </span>
    </div>

    <div
      class="border-neutral-dark/10 flex justify-between items-center border-b py-3"
    >
      <span class="text-neutral-dark/70">Cantidad de matrículas:</span>
      <span class="text-neutral-dark font-semibold">
        {inversion?.cantidadMatriculas ?? 0}
      </span>
    </div>

    <div
      class="border-neutral-dark/10 flex justify-between items-center border-b py-3"
    >
      <span class="text-neutral-dark/70">Costo total de cursos:</span>
      <span class="text-neutral-dark font-semibold">
        {formatMoney(inversion?.sumaCostosCursos)}
      </span>
    </div>

    <div class="bg-secondary text-neutral-white p-6 mt-6">
      <span class="block text-xs font-semibold uppercase tracking-wider mb-2">
        Inversión Total Estimada
      </span>
      <span class="font-display text-3xl leading-none tracking-wide uppercase">
        {formatMoney(inversion?.inversionTotal)}
      </span>
    </div>
  </div>
</section>
