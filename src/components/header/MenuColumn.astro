---
import type { NavSection } from "../../data/navigation";

interface Props {
    section: NavSection;
}

const { section } = Astro.props;
---

<div class="space-y-3 sm:space-y-4">
    <h3
        class="font-display text-secondary pb-1.5 text-xl leading-none tracking-wide uppercase sm:pb-2 sm:text-2xl lg:text-3xl"
    >
        {section.title}
    </h3>

    <ul
        class="text-neutral-white/75 space-y-2 text-base font-light leading-relaxed sm:space-y-2.5 sm:text-lg lg:text-xl xl:text-2xl"
    >
        {
            section.items.map((item) => (
                <li>
                    <a
                        href={item.href}
                        class="inline-block py-0.5 transition-colors duration-200 hover:text-secondary"
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>