---
import FullMenuOverlay from "./FullMenuOverlay.astro";
import Logo from "@/assets/icons/logo.svg";
import Menu from "@/assets/icons/menu.svg";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 transition-colors duration-300"
>
  <div class="pointer-events-none flex flex-col justify-between p-4 md:p-6">
    <div class="container mx-auto grid w-full grid-cols-[1fr_auto_1fr] items-start gap-4 px-4 sm:px-6 lg:px-8">
    <div class="pointer-events-auto relative">
      <button
        type="button"
        id="open-menu-btn"
        aria-label="Abrir menú de navegación"
        class="menu-toggle group flex cursor-pointer items-stretch gap-0.5"
      >
        <span
          class="bg-neutral-black/60 text-neutral-white grid size-12 shrink-0 place-items-center rounded-full border border-neutral-white/20 backdrop-blur-md transition-colors duration-300 group-hover:border-neutral-white/40"
        >
          <Menu class="size-5" />
        </span>
      </button>
    </div>

    <div class="pointer-events-auto flex items-center justify-center">
      <a href="/" class="group flex items-center gap-3" aria-label="Escuela de Posgrado UNSAAC — Inicio">
        <div class="flex items-center gap-2.5">
          <Logo class="text-secondary size-9 shrink-0 sm:size-10" />

          <div class="hidden leading-tight text-left xs:block">
            <span
              class="text-neutral-white block text-xs font-bold tracking-widest uppercase"
              >Escuela de</span
            >
            <span
              class="text-secondary block text-xs font-bold tracking-widest uppercase"
              >Posgrado UNSAAC</span
            >
          </div>
        </div>
      </a>
    </div>

    <div class="pointer-events-auto flex justify-end">
      <button
        type="button"
        class="text-neutral-white grid size-12 cursor-pointer place-items-center rounded-full bg-neutral-black/60 backdrop-blur-md transition-all duration-300 hover:bg-neutral-dark/80 hover:text-secondary"
        aria-label="Buscar"
      >
        <svg
          class="size-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
    </div>
  </div>
  </div>
</header>
<FullMenuOverlay />

<script>
  const header = document.getElementById("site-header");

  const onScroll = () => {
    const scrolled = window.scrollY > 40;
    header?.classList.toggle("bg-primary", scrolled);
    header?.classList.toggle("shadow-lg", scrolled);
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>