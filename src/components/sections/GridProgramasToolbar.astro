---
import {
    LIMITES,
    CLASE_LIMITE_ACTIVO,
    CLASE_LIMITE,
    CLASE_SEGMENTO,
} from "./paginacion-programas";

interface Props {
    q: string;
    size: 5 | 10 | 20;
    inicio: number;
    fin: number;
    totalCarreras: number;
    buildPageUrl: (targetPage: number, newSize?: number) => string;
}

const { q, size, inicio, fin, totalCarreras, buildPageUrl } = Astro.props;
---

<div
    id="grid-toolbar"
    class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"
>
    <p id="grid-info" class="text-neutral-dark text-sm font-medium">
        Mostrando {inicio}–{fin} de {totalCarreras}
    </p>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <form id="grid-search-form" class="flex" role="search" method="GET">
            {size !== 10 && (
                <input type="hidden" name="size" value={size} />
            )}
            <label for="grid-search-input" class="sr-only">
                Buscar programa por nombre
            </label>
            <input
                id="grid-search-input"
                type="search"
                name="q"
                value={q}
                placeholder="Buscar por nombre..."
                class="border-neutral-light bg-neutral-white text-neutral-dark focus:border-primary min-h-10 w-full min-w-0 border-2 px-4 text-sm transition-colors duration-300 outline-none sm:w-64"
            />
            <button
                type="submit"
                class="border-primary bg-primary font-display text-neutral-white hover:border-secondary hover:bg-secondary -ml-0.5 inline-flex min-h-10 shrink-0 items-center justify-center border-2 px-5 text-sm tracking-[0.12em] uppercase transition-all duration-300"
            >
                Buscar
            </button>
        </form>

        <div class="flex items-center gap-3">
            <span class="font-display text-neutral-dark text-sm tracking-[0.12em] uppercase">
                Ver:
            </span>
            <div class="flex" role="group" aria-label="Carreras por página">
                {LIMITES.map((opcion) => {
                    const activo = opcion === size;
                    return (
                        <a
                            href={buildPageUrl(1, opcion)}
                            aria-current={activo ? "true" : undefined}
                            class={`${activo ? CLASE_LIMITE_ACTIVO : CLASE_LIMITE}${CLASE_SEGMENTO}`}
                        >
                            {opcion}
                        </a>
                    );
                })}
            </div>
        </div>
    </div>
</div>