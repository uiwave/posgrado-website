---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { posgradoService } from "../services/api";
import type { TipoProgramaResponse } from "../types/api";
import { Image } from "astro:assets";
import bannerImg from "@/assets/banner.jpg";
import CardTipoPrograma from "@/components/ui/CardTipoPrograma.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import AboutSection from "@/components/sections/AboutSection.astro";
import AdmisionSection from "@/components/sections/AdmisionSection.astro";
import AnnouncementsSection from "@/components/sections/AnnouncementsSection.astro";
import { siteConfig } from "@/config/site";
import BannerPrograms from "@/components/sections/BannerPrograms.astro";
import ProgramsSection from "@/components/sections/ProgramsSection.astro";

let tiposPrograma: TipoProgramaResponse[] = [];
let errorMensaje = "";

try {
  tiposPrograma = await posgradoService.getTiposPrograma();
} catch (error) {
  console.error("Error al cargar los tipos de programa:", error);
  errorMensaje =
    "Lo sentimos, no pudimos cargar los programas en este momento.";
}
---

<Layout>
  <HeroSection />
  <AboutSection />
  {siteConfig.features.procesoAdmision && <AdmisionSection />}
  <AnnouncementsSection />
  <BannerPrograms estadisticas={tiposPrograma} />
  <ProgramsSection programas={tiposPrograma} />
</Layout>
