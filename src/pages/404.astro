---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada">
  <main class="relative flex min-h-screen w-full items-center justify-center px-4">
    <div class="mx-auto w-full max-w-xl space-y-6 py-24 text-center">
      <p
        class="font-display text-primary text-[clamp(6rem,20vw,12rem)] leading-none"
      >
        404
      </p>
      <h1
        class="font-display text-neutral-dark text-[clamp(1.5rem,4vw,2.25rem)] leading-none tracking-wide uppercase"
      >
        Página no encontrada
      </h1>
      <p class="text-neutral-dark mx-auto max-w-md">
        Lo sentimos, la página que buscas no existe o fue movida. Regresa al
        inicio para explorar nuestros programas de posgrado.
      </p>
      <a
        href="/"
        class="border-primary bg-primary font-display text-neutral-white inline-flex items-center justify-center gap-2 border-2 px-8 py-3 text-sm tracking-[0.12em] uppercase transition-all duration-300 hover:border-secondary hover:bg-secondary"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
