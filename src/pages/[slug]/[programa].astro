---
import Layout from "../../layouts/Layout.astro";
import { posgradoService } from "../../services/api";
import type { ProgramaResponse } from "../../types/api";

const { slug, programa } = Astro.params;

if (!programa || !slug) {
  return Astro.redirect("/404");
}

let programaDetail: ProgramaResponse | null = null;
let errorMensaje = "";

try {
  programaDetail = await posgradoService.getProgramaBySlug(programa);

  // Validación con encadenamiento opcional para evitar romper si tipoPrograma es null
  if (programaDetail?.tipoPrograma?.slug && programaDetail.tipoPrograma.slug !== slug) {
    return Astro.redirect(
      `/${programaDetail.tipoPrograma.slug}/${programaDetail.slug}`
    );
  }
} catch (error) {
  console.error(`Error cargando el programa (${programa}):`, error);
  errorMensaje =
    "El programa solicitado no existe o no se encuentra disponible actualmente.";
}

const formatMoney = (amount?: number) => {
  if (amount === undefined || amount === null) return "S/ 0.00";
  return new Intl.NumberFormat("es-PE", {
    style: "currency",
    currency: "PEN",
    minimumFractionDigits: 2,
  }).format(amount);
};
---

<Layout title={programaDetail?.nombre ?? "Programa no encontrado"}>
  <main class="min-h-screen pb-20">
    {
      errorMensaje || !programaDetail ? (
        <div class="max-w-3xl mx-auto pt-20 px-6 text-center">
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
            <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
              !
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">
              Programa no encontrado
            </h1>
            <p class="text-gray-600 mb-6">{errorMensaje}</p>
            <a
              href="/"
              class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
            >
              &larr; Volver al inicio
            </a>
          </div>
        </div>
      ) : (
        <>
          <!-- HEADER / HERO -->
          <header class="bg-gray-900 text-white relative overflow-hidden">
            <div 
              class="absolute inset-0 opacity-20 bg-cover bg-center" 
              style={`background-image: url('${programaDetail.imagen || programaDetail.tipoPrograma?.imagenHero || ""}');`}
            ></div>
            <div class="max-w-7xl mx-auto px-6 py-12 lg:py-16 relative z-10">
              
              <!-- Breadcrumbs con encadenamiento opcional -->
              <nav aria-label="Breadcrumb" class="mb-6 flex items-center text-sm text-gray-300 gap-2">
                <a href="/" class="hover:text-white transition-colors">Inicio</a>
                <span>/</span>
                {programaDetail.tipoPrograma && (
                  <>
                    <a href={`/${programaDetail.tipoPrograma.slug}`} class="hover:text-white transition-colors">
                      {programaDetail.tipoPrograma.nombre}
                    </a>
                    <span>/</span>
                  </>
                )}
                <span class="text-gray-400 truncate max-w-xs">{programaDetail.nombre}</span>
              </nav>

              <!-- Badges protegiendo nulos -->
              <div class="flex flex-wrap items-center gap-3 mb-4">
                {programaDetail.tipoPrograma?.nombre && (
                  <span class="bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                    {programaDetail.tipoPrograma.nombre}
                  </span>
                )}
                {programaDetail.modalidad?.nombre && (
                  <span class="bg-gray-800 text-gray-200 text-xs font-medium px-3 py-1 rounded-full border border-gray-700">
                    {programaDetail.modalidad.nombre}
                  </span>
                )}
                {programaDetail.facultad?.nombre && (
                  <span class="bg-gray-800 text-gray-200 text-xs font-medium px-3 py-1 rounded-full border border-gray-700">
                    Facultad de {programaDetail.facultad.nombre}
                  </span>
                )}
              </div>

              <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-6">
                {programaDetail.nombre}
              </h1>
            </div>
          </header>

          <!-- CONTENIDO PRINCIPAL -->
          <div class="max-w-7xl mx-auto px-6 mt-10">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
              
              <div class="lg:col-span-2 space-y-10">
                
                <!-- Objetivo General -->
                <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
                  <h2 class="text-2xl font-bold text-gray-900 mb-4 border-b pb-3 border-gray-100">
                    Objetivo General
                  </h2>
                  <p class="text-gray-700 leading-relaxed text-lg">
                    {programaDetail.objetivoGeneral || "Sin descripción disponible."}
                  </p>
                </section>

                <!-- Objetivos Específicos & Perfil -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <section class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900 mb-3">
                      Objetivos Específicos
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line">
                      {programaDetail.objetivosEspecificos || "Sin datos especificados."}
                    </p>
                  </section>

                  <section class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900 mb-3">
                      Perfil del Posgraduado
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line">
                      {programaDetail.perfilPosgraduado || "Sin datos especificados."}
                    </p>
                  </section>
                </div>

                <!-- PLAN DE ESTUDIOS -->
                <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
                  <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b pb-3 border-gray-100">
                    Plan de Estudios
                  </h2>

                  {programaDetail.planEstudios && programaDetail.planEstudios.length > 0 ? (
                    <div class="space-y-8">
                      {programaDetail.planEstudios.map((periodoBloque) => (
                        <div>
                          <h3 class="text-lg font-semibold text-blue-900 bg-blue-50 px-4 py-2 rounded-lg mb-4 inline-block">
                            {periodoBloque.periodo?.nombre ?? "Periodo"}
                          </h3>

                          <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm border-collapse">
                              <thead>
                                <tr class="border-b border-gray-200 text-gray-500 font-medium">
                                  <th class="py-2 px-3">Asignatura</th>
                                  <th class="py-2 px-3 text-center">Tipo</th>
                                  <th class="py-2 px-3 text-center">Créditos</th>
                                  <th class="py-2 px-3 text-right">Costo</th>
                                </tr>
                              </thead>
                              <tbody class="divide-y divide-gray-100">
                                {periodoBloque.cursos?.map((curso) => (
                                  <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="py-3 px-3 font-medium text-gray-900">
                                      {curso.asignatura?.nombre ?? "Asignatura no especificada"}
                                    </td>
                                    <td class="py-3 px-3 text-center">
                                      <span class="inline-block px-2 py-0.5 text-xs font-semibold bg-gray-100 text-gray-600 rounded">
                                        {curso.categoria?.nombre ?? "N/A"}
                                      </span>
                                    </td>
                                    <td class="py-3 px-3 text-center text-gray-600">
                                      {curso.creditos ?? 0} crd.
                                    </td>
                                    <td class="py-3 px-3 text-right font-medium text-gray-700">
                                      {formatMoney(curso.costo)}
                                    </td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="text-gray-500 italic">No hay asignaturas registradas actualmente.</p>
                  )}
                </section>

              </div>

              <!-- RESUMEN DE INVERSIÓN -->
              <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-200 sticky top-8">
                  <h3 class="text-xl font-bold text-gray-900 mb-6">
                    Resumen de Inversión
                  </h3>

                  <div class="space-y-4 mb-6 text-sm">
                    <div class="flex justify-between items-center py-2 border-b border-gray-100">
                      <span class="text-gray-600">Matrícula por periodo:</span>
                      <span class="font-semibold text-gray-900">
                        {formatMoney(programaDetail.inversion?.costoMatricula)}
                      </span>
                    </div>

                    <div class="flex justify-between items-center py-2 border-b border-gray-100">
                      <span class="text-gray-600">Cantidad de matrículas:</span>
                      <span class="font-semibold text-gray-900">
                        {programaDetail.inversion?.cantidadMatriculas ?? 0}
                      </span>
                    </div>

                    <div class="flex justify-between items-center py-2 border-b border-gray-100">
                      <span class="text-gray-600">Costo total de cursos:</span>
                      <span class="font-semibold text-gray-900">
                        {formatMoney(programaDetail.inversion?.sumaCostosCursos)}
                      </span>
                    </div>

                    <div class="bg-blue-50 p-4 rounded-xl mt-4">
                      <span class="block text-xs font-semibold text-blue-800 uppercase tracking-wider mb-1">
                        Inversión Total Estimada
                      </span>
                      <span class="text-3xl font-extrabold text-blue-900">
                        {formatMoney(programaDetail.inversion?.inversionTotal)}
                      </span>
                    </div>
                  </div>

                  <button
                    type="button"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 text-center"
                  >
                    Postular Ahora
                  </button>
                  
                  <p class="text-xs text-gray-400 text-center mt-3">
                    Los costos están sujetos a variaciones según el reglamento institucional.
                  </p>
                </div>
              </div>

            </div>
          </div>
        </>
      )
    }
  </main>
</Layout>