---
import Layout from "@/layouts/Layout.astro";
import { posgradoService } from "@/services/api";
import HeroProgramSection from "@/components/sections/HeroProgramSection.astro";
import GridProgramasSection from "@/components/sections/GridProgramasSection.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

let tipoPrograma;

try {
  tipoPrograma = await posgradoService.getTipoProgramaBySlug(slug);
} catch (error) {
  console.error("Error al cargar los tipos de programa:", error);
}

if (!tipoPrograma) {
  return Astro.redirect("/404");
}

const tituloCategoria = tipoPrograma?.nombre
const heroImagen = tipoPrograma?.imagenHero;
const data = slug
---

<Layout title={`Programas de ${tituloCategoria}`}>
  <HeroProgramSection titulo={tituloCategoria} imagen={heroImagen}/>
  {slug}
  <GridProgramasSection slug={slug} />
</Layout>

